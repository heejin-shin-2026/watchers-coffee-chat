# Supabase (https://supabase.com → 프로젝트 생성 후 Settings > API에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 관리자 세션 서명 키 (32자 이상 랜덤 문자열)
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# 전화번호 암호화 키 (64자리 hex = 32바이트, 예: openssl rand -hex 32)
PHONE_ENCRYPTION_KEY=change-me-to-64-hex-chars
